{
  "name": "catercloud-lead-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "CaterCloud lead tracker — the six GoHighLevel webhook to Google Sheets workflows, ported from n8n to code.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "googleapis": "185.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.19.2",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
