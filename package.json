{
  "name": "catercloud-automations",
  "version": "1.0.0",
  "private": true,
  "description": "CaterCloud marketing automations — GoHighLevel social posting and lead-tracker webhooks, ported from n8n to code.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "run:social": "tsx src/cli/run-social.ts"
  },
  "dependencies": {
    "croner": "8.1.2",
    "fastify": "4.28.1",
    "googleapis": "144.0.0",
    "openai": "4.73.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
