    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.messageText }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an intent classification assistant for a CSM operations system.\n\nYour task is to analyze incoming WhatsApp messages and classify them into one of the following intent categories:\n\n- STATUS_QUERY: Questions about current status, pipeline stages, or general information requests\n- BLOCKER_QUERY: Questions about what is blocked, stuck, or preventing progress\n- MISSING_ASSETS: Questions about missing documents, files, or assets\n- DRAFT_MESSAGE: Requests to draft or compose a message to a client\n- CREATE_TASK: Requests to create a task or assign work to someone\n- READINESS_CHECK: Questions about whether clients are ready for specific actions (ads, build, launch, etc.)\n- UNKNOWN: Messages that do not fit any of the above categories\n\nExtract the client name if mentioned in the message. Return your classification in the structured format."
        }
      },
      "id": "5a457386-7fdf-42ab-b34e-e5c5626acd58",
      "name": "Intent Classifier Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        728,
        288
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4.1-mini"
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "70cd20da-284d-4b6d-a183-8f5f9a286b7d",
      "name": "OpenAI Chat Model - Classifier",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        672,
        512
      ],
      "credentials": {
        "openAiApi": {
          "id": "5zuncWDIceveqruE",
          "name": "n8n free OpenAI API credits"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"intent\": {\n      \"type\": \"string\",\n      \"enum\": [\"STATUS_QUERY\", \"BLOCKER_QUERY\", \"MISSING_ASSETS\", \"DRAFT_MESSAGE\", \"CREATE_TASK\", \"READINESS_CHECK\", \"UNKNOWN\"]\n    },\n    \"clientName\": {\n      \"type\": \"string\"\n    },\n    \"confidence\": {\n      \"type\": \"number\"\n    }\n  },\n  \"required\": [\"intent\", \"confidence\"]\n}"
      },
      "id": "2a2f75f0-d0dd-4fe7-b35c-510df2ce95b7",
      "name": "Intent Classification Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        800,
        512
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "STATUS_QUERY",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "STATUS_QUERY"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "BLOCKER_QUERY",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "BLOCKER_QUERY"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "MISSING_ASSETS",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "MISSING_ASSETS"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "CREATE_TASK",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "CREATE_TASK"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Other Intents"
        }
