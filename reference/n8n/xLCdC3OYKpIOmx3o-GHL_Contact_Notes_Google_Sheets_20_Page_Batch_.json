    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const note = $input.item.json;\n\n// Clean and format the note body\nconst rawBody = note.bodyText || '';\nconst cleanBody = rawBody\n  .replace(/\\r\\n/g, ' | ')\n  .replace(/\\n/g, ' | ')\n  .replace(/\\r/g, ' | ')\n  .replace(/\\s{2,}/g, ' ')\n  .trim();\n\n// Format date nicely\nlet formattedDate = '';\nif (note.dateAdded) {\n  const d = new Date(note.dateAdded);\n  const day = String(d.getDate()).padStart(2, '0');\n  const month = String(d.getMonth() + 1).padStart(2, '0');\n  const year = d.getFullYear();\n  const hours = String(d.getHours()).padStart(2, '0');\n  const mins = String(d.getMinutes()).padStart(2, '0');\n  formattedDate = `${day}/${month}/${year} ${hours}:${mins}`;\n}\n\nreturn {\n  json: {\n    contact_id: note.contactId || '',\n    contact_name: note.contactName || '',\n    contact_email: note.contactEmail || '',\n    note_id: note.id || '',\n    note_bodyText: cleanBody,\n    created_by: note.createdBy || '',\n    date_added: formattedDate\n  }\n};"
      },
