      "id": "125e3eb2-c857-49aa-a509-e4cad4420819",
      "name": "Split Contacts1",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        -1088,
        -16
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst grouped = {};\n\nfor (const item of items) {\n  const data = item.json;\n  const contactId = data.contact_id;\n\n  if (!grouped[contactId]) {\n    grouped[contactId] = {\n      contact_id: contactId,\n      contact_name: data.contact_name,\n      contact_email: data.contact_email,\n      notes: []\n    };\n  }\n\n  grouped[contactId].notes.push({\n    date: data.date_added,\n    body: data.note_bodyText\n  });\n}\n\n// build final output\nreturn Object.values(grouped).map(contact => {\n\n  const sortedNotes = contact.notes.sort((a, b) => {\n    const dateA = new Date(a.date.split('/').reverse().join('-'));\n    const dateB = new Date(b.date.split('/').reverse().join('-'));\n    return dateA - dateB;\n  });\n\n  const combinedNotes = sortedNotes.map(n => {\n    return `[${n.date}]\n${n.body}`;\n  }).join('\\n\\n-------------------\\n\\n');\n\n  return {\n    json: {\n      contact_id: contact.contact_id,\n      contact_name: contact.contact_name,\n      contact_email: contact.contact_email,\n      all_notes: combinedNotes\n    }\n  };\n});"
      },
