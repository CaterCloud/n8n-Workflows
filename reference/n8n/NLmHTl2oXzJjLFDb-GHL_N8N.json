      "parameters": {
        "jsCode": "const requiredFolders = ['shop', 'staff', 'customers', 'food'];\nconst minFiles = 5;\n\n// Group files by folder from Google Drive output\nconst filesGrouped = {};\n$items('Google Drive').forEach(item => {\n  const folder = item.json.name; \n  if (!filesGrouped[folder]) {\n    filesGrouped[folder] = [];\n  }\n  filesGrouped[folder].push(item.json);\n});\n\n// Check file count per folder\nconst foldersWithLowFiles = requiredFolders.filter(folder => {\n  return !filesGrouped[folder] || filesGrouped[folder].length < minFiles;\n});\n\nreturn [\n  {\n    json: {\n      validation_passed: foldersWithLowFiles.length === 0,\n      folders_with_low_files: foldersWithLowFiles,\n      files_grouped: filesGrouped\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -740,
        60
      ],
      "id": "4932ae01-3340-474a-8723-4bf569818898",
      "name": "Validate File Count"
    },
    {
      "parameters": {
        "jsCode": "const filesGrouped = $json.files_grouped;\nconst rotationHistory = {}; // (Later, you can store this in DB/Custom Fields)\n\nconst selectedContent = [];\nconst maxPosts = 1; // Adjust to how many posts per trigger\n\nObject.keys(filesGrouped).forEach(folder => {\n  const unusedFiles = filesGrouped[folder].filter(file => {\n    const lastUsed = rotationHistory[file.id];\n    if (!lastUsed) return true;\n    const thirtyDays = 30 * 24 * 60 * 60 * 1000;\n    return Date.now() - lastUsed > thirtyDays;\n  });\n\n  if (unusedFiles.length > 0) {\n    const randomFile = unusedFiles[Math.floor(Math.random() * unusedFiles.length)];\n    selectedContent.push({\n      folder,\n      file: randomFile\n    });\n\n    // Update rotation history (this will later be saved externally)\n    rotationHistory[randomFile.id] = Date.now();\n  }\n});\n\n// Limit the posts if necessary\nreturn [\n  {\n    json: {\n      selected_content: selectedContent.slice(0, maxPosts)\n    }\n  }\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
