      "parameters": {
        "jsCode": "return items.map(item => {\n  // Clean and parse OpenAI JSON\n  const cleanContent = item.json.message.content\n    .replace(/```json\\n?/, '')\n    .replace(/```/, '')\n    .trim();\n\n  let parsed;\n  try {\n    parsed = JSON.parse(cleanContent);\n  } catch (e) {\n    parsed = { caption: \"Default caption\", platform_variations: {} };\n  }\n\n  return {\n    json: {\n      accountIds: [\n        \"66a092ff9da3812b8506def4_NeGmNMm3xs5QfUpL5qRA_10164004163556484867\",\n        \"66a094069da38160a706df6b_NeGmNMm3xs5QfUpL5qRA_359381653933375_page\",\n        \"66a0942d72c2be83def034e4_NeGmNMm3xs5QfUpL5qRA_17841453456772009\"\n      ],\n      summary: parsed.caption,  // ✅ Now correctly resolved\n      media: [\n        {\n          url: item.json.imageUrl || \"https://via.placeholder.com/800\",\n          caption: parsed.caption,\n          type: \"image/jpeg\"\n        }\n      ],\n      status: \"draft\",\n      type: \"post\",\n      userId: \"USERID\"\n    }\n  };\n});"
