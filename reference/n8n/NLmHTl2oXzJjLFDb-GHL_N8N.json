      "parameters": {
        "jsCode": "// Required folders for validation\nconst requiredFolders = ['shop', 'staff', 'customers', 'food'];\n\n// Extract all folder names from the Google Drive output\nconst allFolders = $input.all().map(item => item.json.name);\n\n// Identify missing folders\nconst missingFolders = requiredFolders.filter(folder => !allFolders.includes(folder));\n\nreturn [\n  {\n    json: {\n      validation_passed: missingFolders.length === 0,\n      missing_folders: missingFolders,\n      all_folders: allFolders\n    }\n  }\n];\n"
      },
