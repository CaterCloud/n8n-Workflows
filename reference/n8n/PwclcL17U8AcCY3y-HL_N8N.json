    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => {\n  const postingDate = item.json?.['Posting Date'] || '';\n  const date = new Date(postingDate + 'T12:00:00.000Z');\n  const formatted_date = date.toISOString();\n  const caption = item.json?.['Caption'] || '';\n  const images = Array.from(item.json?.['Image'] || []);\n  return {\n    json: {\n      formatted_date,\n      caption,\n      images\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1760,
        900
      ],
      "id": "f7910a61-d85e-4494-aa80-b5c2a0634748",
      "name": "Format_Date1"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst extractAccountIdsByPlatform = jsonData => {\n  const data = Array.isArray(jsonData) ? jsonData[0] : jsonData;\n  if (!data['success'] || !data['results'] || !data['results']['accounts']) {\n    throw new Error('Invalid response format or unsuccessful API call');\n  }\n  const accounts = data['results']['accounts'];\n  const platforms = ['facebook', 'google', 'instagram', 'tiktok', 'pinterest'];\n  const platformAccounts = Object.fromEntries(\n    platforms.map(p => [p, accounts.filter(account => (account['platform'] || '').toLowerCase() === p).map(account => ({\n      id: account['id'],\n      originId: account['originId'],\n      name: account['name'],\n      type: account['type'],\n      isExpired: account['isExpired']\n    }))])\n  );\n  return platformAccounts;\n};\nconst getAccountIdsByPlatform = (jsonData, platform) => {\n  const platformAccounts = extractAccountIdsByPlatform(jsonData);\n  const platformKey = (platform || '').toLowerCase();\n  if (!Object.prototype.hasOwnProperty.call(platformAccounts, platformKey)) {\n    throw new Error('Platform ' + platform + ' not supported. Available platforms: ' + Object.keys(platformAccounts).join(', '));\n  }\n  return platformAccounts[platformKey].map(account => account['id']);\n};\nconst getAllAccountIds = jsonData => {\n  const platformAccounts = extractAccountIdsByPlatform(jsonData);\n  return Object.fromEntries(\n    Object.keys(platformAccounts).map(platform => [platform, platformAccounts[platform].map(account => account['id'])])\n  );\n};\nreturn items.map(item => {\n  const jsondata = item.json?.jsondata || item.json;\n  const byPlatform = extractAccountIdsByPlatform(jsondata);\n  const allIds = getAllAccountIds(jsondata);\n  const facebookIds = getAccountIdsByPlatform(jsondata, 'facebook');\n  const instagramIds = getAccountIdsByPlatform(jsondata, 'instagram');\n  return {\n    json: {\n      by: byPlatform,\n      allIds: allIds,\n      facebookIds: facebookIds,\n      instagramIds: instagramIds\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
