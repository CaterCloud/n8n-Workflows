# ---------------------------------------------------------------------------
# catercloud-lead-tracker — copy to .env for local work, or paste into
# Railway variables. Nothing here is committed with a real value.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Zone used to render the "OPTED IN DATE / TIME" column. The one workflow in
# the export that declared a timezone set Australia/Sydney.
TIMEZONE=Australia/Sydney

# --- Google Sheets access -------------------------------------------------
# Pick one. See docs/GOOGLE-OAUTH.md for both walkthroughs.
#
# Option A (recommended): a service account key, pasted whole. Nothing
# expires, and there is no consent flow — but the spreadsheet must be shared
# with the key's client_email as an Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
#
# Option B: an OAuth user refresh token. No sharing step, but revocable, and
# tokens expire weekly while the consent screen is in Testing mode.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Destination spreadsheet ----------------------------------------------
# "PEE Optin - Utm". The tab name has a trailing space — keep it.
LEAD_SHEET_ID=1XETq_e721_67XJgyWPBC365HhAxCojrSwdVCkDVzTjw
LEAD_SHEET_NAME=PEE 

# --- Access control -------------------------------------------------------
# Required on the webhook routes when set. Send it as an x-webhook-secret
# header, an "Authorization: Bearer <secret>" header, or ?secret=<secret>.
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=
# Required on /admin/* when set.
ADMIN_TOKEN=

# Accept and log webhooks without writing to the sheet. Useful while you
# point GoHighLevel at this service and watch what arrives.
DRY_RUN=false
