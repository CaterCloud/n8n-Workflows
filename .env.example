# ---------------------------------------------------------------------------
# catercloud-automations — copy to .env for local work, or paste into Railway
# variables. Nothing here is committed with a real value.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Every cron expression and every scheduled post time is read in this zone.
SCHEDULE_TIMEZONE=Australia/Sydney

# --- Google (Drive + Sheets), OAuth user refresh token --------------------
# See docs/GOOGLE-OAUTH.md for how to mint these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Cloudinary (unsigned upload preset) ----------------------------------
CLOUDINARY_CLOUD_NAME=dvouhqxi4
CLOUDINARY_UPLOAD_PRESET=n8n_upload

# --- GoHighLevel ----------------------------------------------------------
# Shared fallback token. Per-client overrides take precedence:
#   GHL_TOKEN_JUNCTION_CAFE, GHL_TOKEN_SPANISH_PAELLA, GHL_TOKEN_AVO_SHACK,
#   GHL_TOKEN_MADAME_CUE, GHL_TOKEN_MADISON_AVE
# GoHighLevel PITs are location-scoped, so each client normally needs its own.
GHL_API_TOKEN=
GHL_TOKEN_JUNCTION_CAFE=
GHL_TOKEN_SPANISH_PAELLA=
GHL_TOKEN_AVO_SHACK=
GHL_TOKEN_MADAME_CUE=
GHL_TOKEN_MADISON_AVE=

# Agency JWT for the legacy v1 location pre-flight. Optional — the pre-flight
# is skipped when unset, and a failure there never stops a run.
GHL_AGENCY_JWT=

# Default post author. The n8n workflows hardcoded lWZjS6ppoRL7w9v2r1VM.
GHL_USER_ID=lWZjS6ppoRL7w9v2r1VM
GHL_API_VERSION=2021-07-28

# --- Lead tracker spreadsheet ---------------------------------------------
# "PEE Optin - Utm"; the tab name has a trailing space.
LEAD_SHEET_ID=1XETq_e721_67XJgyWPBC365HhAxCojrSwdVCkDVzTjw
LEAD_SHEET_NAME=PEE 

# --- Access control -------------------------------------------------------
# Required on the lead webhooks when set (x-webhook-secret, Bearer, or ?secret=).
WEBHOOK_SECRET=
# Required on /admin/* when set.
ADMIN_TOKEN=

# --- Rollout switches -----------------------------------------------------
# `none` (default), `all`, or a comma-separated slug list. Keep at `none`
# until n8n is switched off, or both will post.
SOCIAL_ENABLED_CLIENTS=none
SOCIAL_DISABLED_CLIENTS=
# Build and log GHL payloads without sending them.
SOCIAL_DRY_RUN=false
SCHEDULER_ENABLED=true

# Optional per-client config patch, keyed by slug. Example:
# SOCIAL_CLIENT_OVERRIDES={"madame-cue":{"schedules":[{"name":"monthly","cron":"0 10 4 * *","imageCount":30,"minImages":30}]}}
SOCIAL_CLIENT_OVERRIDES=

HTTP_TIMEOUT_MS=30000
HTTP_MAX_RETRIES=3
